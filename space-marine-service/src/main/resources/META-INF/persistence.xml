<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="spacemarine" transaction-type="JTA">
        <!-- Тот самый пул из Payara -->
        <jta-data-source>jdbc/spacemarine</jta-data-source>
        <!-- Брать все классы с @Entity из WAR -->
        <exclude-unlisted-classes>false</exclude-unlisted-classes>
        <shared-cache-mode>NONE</shared-cache-mode>
        <properties>
            <!-- Таблицы создаём сами скриптом, JPA их не трогает -->
            <property name="jakarta.persistence.schema-generation.database.action" value="none"/>
            <!-- Показывать SQL в логе Payara: удобно при отладке -->
            <property name="eclipselink.logging.level.sql" value="FINE"/>
            <property name="eclipselink.logging.parameters" value="true"/>
        </properties>
    </persistence-unit>
</persistence>